# Airwallex sandbox (sandbox.airwallex.com → Developer → API keys)
AIRWALLEX_CLIENT_ID=
AIRWALLEX_API_KEY=
AIRWALLEX_BASE_URL=https://api.sandbox.airwallex.com
# Optional: the PSP key Airwallex charges with after onboarding (scripts/ac_onboard.py).
# Leave both empty to use the key above.
AIRWALLEX_PSP_CLIENT_ID=
AIRWALLEX_PSP_API_KEY=

# Claude (the shopping agent). Model IDs live here, never in code.
ANTHROPIC_API_KEY=
COUNTERSIGN_AGENT_MODEL=

# The agent's TAP signing key: base64 of the raw 32-byte Ed25519 private key.
# Generate one with: python -m countersign keygen
TAP_PRIVATE_KEY_B64=
TAP_KEY_ID=
TAP_SIGNATURE_AGENT=

# The public https host of the merchant edge: catalogue rows link to /p/<sku> and /img/<sku>.svg here.
COUNTERSIGN_PUBLIC_URL=

# The checkout API Airwallex calls (create_checkout). No secret, no /acp routes.
COUNTERSIGN_ACP_HMAC_SECRET=
COUNTERSIGN_ACP_HMAC_SCHEME=airwallex
COUNTERSIGN_ACP_OBSERVE=
COUNTERSIGN_REQUIRE_SHOPPER_SIGNATURE=
COUNTERSIGN_ACP_CURRENCY=
